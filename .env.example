# Copy this file to .env and fill in your real values.
# .env is in .gitignore, so it will never be committed to git.

# Your Jira Cloud site, no trailing slash
JIRA_SITE_URL=https://allvuesystems.atlassian.net

# The Atlassian account email that owns the API token below
JIRA_EMAIL=ibernal@allvuesystems.com

# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=paste_your_token_here

# Jira project keys to monitor, comma-separated, no spaces
JIRA_PROJECT_KEYS=CSSD,PIE,ACP,IAP

# Only pull tickets assigned to these people. Use their exact Jira display
# name (the name shown on their profile/avatar), comma-separated. Leave this
# blank to pull tickets for every assignee instead.
JIRA_TEAM_MEMBERS=Isaac Bernal,Yaumara Torres,Viacheslav Golovach,Benjamin Sanchez Cuellar,Jose Muguira Marrero,Varun Saxena,Steve Jimenez
